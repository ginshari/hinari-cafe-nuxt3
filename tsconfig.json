{
  // https://nuxt.com/docs/guide/concepts/typescript
  // Nuxt 4 は app / server / shared / node (nuxt.config) ごとに tsconfig を生成する。
  // scripts/ と functions/ は Nuxt の外で動くため、どれにも含まれない。
  // Nuxt が生成する tsconfig は types を空にするため @types/node は自動で入らない。
  // scripts/ の Node API は各ファイル先頭の /// <reference types="node" /> で参照する
  // (アプリ全体に node のグローバルを公開しないため)。
  "files": [],
  "references": [
    { "path": "./.nuxt/tsconfig.app.json" },
    { "path": "./.nuxt/tsconfig.server.json" },
    { "path": "./.nuxt/tsconfig.shared.json" },
    { "path": "./.nuxt/tsconfig.node.json" }
  ]
}
